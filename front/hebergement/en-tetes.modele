# Modèle du fichier d'en-têtes de l'hébergeur (PF-09). À chaque build, outils/en-tetes.mjs en écrit
# dist/front/browser/_headers, sans ces commentaires :
# - {{empreintes}} devient les empreintes SHA-256 des scripts en ligne exécutables de tous les HTML
#   du build, jamais écrites à la main ; {{base-api}}, la base de l'API de l'environnement, retirée
#   quand elle est vide : connect-src s'en tient alors à 'self' ;
# - en test et en développement, servis en HTTP, upgrade-insecure-requests et
#   Strict-Transport-Security sont retirés ; en production, X-Robots-Tag est retiré ;
# - la règle du CV n'est écrite que si le fichier du CV est dans le build.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{empreintes}}; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' {{base-api}}; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  X-Robots-Tag: noindex

# Scripts et styles, dont Angular met l'empreinte dans le nom, et polices, versionnées par le leur.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/polices/*
  Cache-Control: public, max-age=31536000, immutable

# Le CV, sans politique, pour ne pas gêner la visionneuse PDF intégrée des navigateurs.
/cv/{{fichier-cv}}
  ! Content-Security-Policy
